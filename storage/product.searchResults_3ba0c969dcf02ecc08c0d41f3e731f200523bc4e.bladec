<?php $_shouldextend[1]=1; ?>

<?php $this->startSection('content'); ?>
<div class="container mt-5">
 <h2>Kết quả tìm kiếm cho: "<?php echo \htmlentities($query??'', ENT_QUOTES, 'UTF-8', false); ?>"</h2>
 <?php if(count($Products) > 0): ?>
 <div class="row">
 <?php $__currentLoopData = $Products; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $product): $loop = $this->incrementLoopIndices();  ?>
 <?php 
 $hinhpart = 'public/assets/img/courses/' . $product->image;
 ?>
 <div class="col-md-4 mb-4">
 <div class="card h-100">
 <img class="card-img-top w-100" src="<?php echo \htmlentities(BASE_URL . '/' . $hinhpart??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="courses" />
 <div class="card-body">
 <h5 class="font-sans-serif fw-bold fs-md-0 fs-lg-1"><?php echo \htmlentities($product->name??'', ENT_QUOTES, 'UTF-8', false); ?></h5>
 <a class="text-muted fs--1 stretched-link text-decoration-none"
 href="<?php echo \htmlentities(BASE_URL . 'client/product/product_detail/' . $product->id??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <?php echo \htmlentities($product->description??'', ENT_QUOTES, 'UTF-8', false); ?>

 </a>
 </div>
 </div>
 </div>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </div>
 <?php else: ?>
 <p>Không tìm thấy kết quả nào.</p>
 <?php endif; ?>
</div>
<?php $this->stopSection(); ?>

<?php if (isset($_shouldextend[1])) { echo $this->runChild('layout.main'); } ?>